# Apify API token (for ImmoScout24 + Immowelt dataset fetching)
APIFY_API_TOKEN=your_apify_token_here

# Apify Actor IDs (the actors added to your schedule)
# These default to the correct actors if not set, so these are optional overrides
# APIFY_IMMOSCOUT_ACTOR_ID=fatihtahta/immobilienscout24-scraper
# APIFY_IMMOWELT_ACTOR_ID=igolaizola/immowelt-scraper

# Telegram Bot (for notifications)
# 1. Message @BotFather on Telegram, send /newbot, get the token
# 2. Start a chat with your bot, send "hi"
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates to get your chat_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Cron secret (Vercel auto-injects this for cron jobs, but set it for local testing)
CRON_SECRET=your_cron_secret_here
